{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "north-star-neighbors",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "triggers": {
    "crons": ["*/10 * * * *"]
  }
}